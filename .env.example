# Supabase (Google auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers — keys stay server-side only (never NEXT_PUBLIC_)
# AI_ORDER is a comma-separated list of provider:model pairs tried in order.
# Groq first (fast fail/success). Gemini Flash next; Lite last (different capacity).
AI_ORDER=groq:qwen/qwen3.8-27b,google:gemini-3.8-flash,google:gemini-3.7-flash,google:gemini-3.5-flash-lite

GOOGLE_API_KEY=
GROQ_API_KEY=

# Say hi form — messages are saved first, then emailed via Resend (server-only)
# Resend API key (resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives Say hi messages
CONTACT_TO=
# Sender address; onboarding@resend.dev works until you verify a domain
CONTACT_FROM=onboarding@resend.dev
