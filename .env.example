# --- Required ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers — keys stay server-side only (never NEXT_PUBLIC_)
# AI_ORDER is a comma-separated list of provider:model pairs tried in order.
# At least one matching key below is required.
# Groq first (fast fail/success). Gemini Flash next; Lite last (different capacity).
AI_ORDER=groq:qwen/qwen3.8-27b,google:gemini-3.8-flash,google:gemini-3.7-flash,google:gemini-3.5-flash-lite

GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Optional — Say hi contact form (API email; not auth mail) ---
# Resend API key (resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives Say hi messages
CONTACT_TO=
# Sender address — use a verified domain to reach testers (not only yourself)
CONTACT_FROM=onboarding@resend.dev

# --- Optional — daily Your day cron (Vercel Production) ---
# Supabase service role — cron only, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional: YYYY-MM-DD floor so cron never backfills older days
SUMMARY_CRON_SINCE=2026-11-11
# Set to 1 to log planned actions without writing
CRON_DRY_RUN=

# Auth (Google OAuth client, Custom SMTP, email templates) is configured in the
# Supabase dashboard — see README “Auth setup”. Password-reset mail is NOT sent
# by RESEND_API_KEY; use Supabase Custom SMTP (e.g. Resend SMTP) for that.
